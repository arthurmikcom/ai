# Скопируйте этот файл в .env.local и заполните нужные значения.
# Для запуска на своём компьютере достаточно ОДНОГО ключа провайдера:
# база данных и хранилище файлов создадутся сами в папке .data/.
# Все значения читаются только на сервере и никогда не попадают в браузер.

# ---------- Кто продаёт: страницы /terms, /refund и /privacy ----------
# Платёжные системы проверяют эти страницы перед подключением. Название компании или ФИО,
# адрес и почта для клиентов (возвраты, вопросы о данных).
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_EMAIL=

# ---------- Режим моделей ----------
# По умолчанию пользователи видят только наш ИИ MARYX: без выбора моделей, без названий
# сторонних моделей и провайдеров, без своего ключа OpenRouter. MARYX сам выбирает модель внутри.
# true — вернуть выбор всех моделей, их названия в ответах и свой ключ OpenRouter.
SHOW_ALL_MODELS=

# ---------- Модели: чат ----------

# Claude (Opus, Sonnet, Haiku, Fable): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# GPT-модели + генерация изображений GPT Image: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Gemini + изображения (Imagen, Nano Banana) + видео (Veo): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Один ключ на всё: Claude, GPT, Gemini, Grok, DeepSeek, сотни других моделей,
# а также картинки и видео: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Grok: https://console.x.ai
XAI_API_KEY=

# Qwen напрямую от Alibaba Cloud (Model Studio): https://modelstudio.console.alibabacloud.com/
# Ключ привязан к региону; по умолчанию Сингапур. Для США или Пекина укажите адрес:
# DASHSCOPE_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1   # США
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1      # Пекин
# (без этого ключа Qwen всё равно доступен через OpenRouter)
DASHSCOPE_API_KEY=

# Свой сервер с открытыми моделями (например Qwen на арендованной видеокарте):
# vLLM, SGLang, LM Studio или любой OpenAI-совместимый сервер. Адрес с /v1 на конце,
# только https:// (по http ключ и переписка идут незашифрованными) — см. README, раздел «Qwen».
# CUSTOM_LLM_BASE_URL=https://ваш-адрес/v1
# CUSTOM_LLM_API_KEY=   # секрет из --api-key
# CUSTOM_LLM_VISION=1   # если модель понимает картинки

# Свои локальные модели через Ollama (https://ollama.com): бесплатно, без ключей.
# После установки: `ollama pull llama3.2`, затем раскомментируйте строку ниже.
# OLLAMA_BASE_URL=http://localhost:11434

# ---------- Модели: изображения и видео ----------

# FLUX, Ideogram, Recraft, Kling, Veo, Seedance и тысячи других моделей:
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Видео в чате и «Тренде»: предел одного файла в МБ (по умолчанию 2048 = 2 ГБ)
# и сколько МБ видео один человек может загрузить в сутки (по умолчанию 4096).
NEXT_PUBLIC_MAX_VIDEO_MB=
DAILY_UPLOAD_MB=

# Картинки и видео бесплатно на своей видеокарте (ComfyUI: FLUX.1 schnell и Wan 2.2), см. README.
# Адрес сервера и пароль к прокси перед ним: токен (уйдёт как Bearer) или целиком "Basic …".
COMFYUI_URL=
COMFYUI_TOKEN=

# «Тренд» → «Точный повтор» через Higgsfield (платно, по секундам ролика), см. README.
HF_API_KEY_ID=
HF_API_KEY_SECRET=
HIGGSFIELD_RESOLUTION=

# ---------- База данных и файлы ----------

# PostgreSQL (на Vercel: Storage → Neon, переменная появится сама).
# Пусто = встроенная база в .data/ (только для своего компьютера).
DATABASE_URL=

# Хранилище файлов Vercel Blob (Storage → Blob, тип доступа Private →
# Connect Project). Vercel добавит BLOB_READ_WRITE_TOKEN или только
# BLOB_STORE_ID (тогда сайт входит в хранилище по OIDC-токену Vercel).
# Пусто = файлы в папке .data/files/.
BLOB_READ_WRITE_TOKEN=

# ---------- Аккаунты ----------

# Секрет для подписи сессий: 32+ случайных символа (`openssl rand -base64 32`).
# Обязателен на Vercel. Локально, если пусто, создаётся сам в .data/.
BETTER_AUTH_SECRET=

# Адрес сайта, например https://maryx-ai.vercel.app (на Vercel определяется сам).
BETTER_AUTH_URL=

# Вход через Google (необязательно). Redirect URI: <адрес сайта>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Вход через VK ID (необязательно). Redirect URI: <адрес сайта>/api/auth/callback/vk
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# Администраторы (без лимитов, создают промокоды, видят статус провайдеров):
# ID аккаунтов через запятую — ID виден в Настройках под вашей почтой.
ADMIN_USER_IDS=
# …или почты через запятую, но они работают только для подтверждённой почты
# (например, вход через Google). Обычная регистрация по паролю почту не подтверждает.
ADMIN_EMAILS=

# ---------- Тарифы и лимиты (в сутки на пользователя) ----------
# Все запросы идут через сервер с ключами сайта; лимиты считаются на каждого пользователя.
# Число или `unlimited`. По умолчанию Free: 20 сообщений, 3 изображения, видео нет (0);
# Plus: 150 сообщений, 30 изображений, 3 видео; Pro: 500, 100, 10; Ultra: 2000, 300, 30.
# Сверх лимита запросы оплачиваются кредитами.
FREE_DAILY_CHAT=
FREE_DAILY_IMAGE=
FREE_DAILY_VIDEO=
PLUS_DAILY_CHAT=
PLUS_DAILY_IMAGE=
PLUS_DAILY_VIDEO=
PRO_DAILY_CHAT=
PRO_DAILY_IMAGE=
PRO_DAILY_VIDEO=
ULTRA_DAILY_CHAT=
ULTRA_DAILY_IMAGE=
ULTRA_DAILY_VIDEO=
# Голосовой ввод (распознаваний речи в сутки). По умолчанию Free 20, Plus 100, Pro 300, Ultra 1000.
FREE_DAILY_VOICE=
PLUS_DAILY_VOICE=
PRO_DAILY_VOICE=
ULTRA_DAILY_VOICE=
# Чем рисует бесплатный тариф: free (по умолчанию) — бесплатная нейросеть без ключа (FLUX через
# Pollinations или своя видеокарта, COMFYUI_URL), кредиты не тратятся; gpt — GPT Image в лимитах тарифа.
# Платные тарифы и кредиты всегда рисуют GPT Image.
FREE_PLAN_IMAGES=
# Адрес бесплатной нейросети (по умолчанию старый адрес Pollinations без ключа https://image.pollinations.ai/prompt;
# off — выключить). Pollinations официально перешёл на ключи, и старый адрес может перестать отвечать: тогда
# подключите свою видеокарту (COMFYUI_URL), ключ ниже или FREE_PLAN_IMAGES=gpt.
POLLINATIONS_URL=
# Необязательный ключ Pollinations (платный, «pollen»): с ним используется их новый адрес https://gen.pollinations.ai/image.
POLLINATIONS_TOKEN=

# Дневной бюджет на чат и голос в долларах на одного пользователя: защищает от того, кто весь день
# пишет дорогим моделям или шлёт большие файлы (у картинок и видео — свой месячный бюджет ниже).
# Число или `unlimited`. По умолчанию Free 0.20, Plus 0.40, Pro 1.00, Ultra 2.50.
FREE_DAILY_USD=
PLUS_DAILY_USD=
PRO_DAILY_USD=
ULTRA_DAILY_USD=
# Месячный бюджет на картинки и видео в долларах на одного пользователя: подписка никогда не стоит вам
# больше, чем приносит. Дальше — за кредиты. Число или `unlimited`. По умолчанию Free 1, Plus 3, Pro 6, Ultra 15.
FREE_MONTHLY_MEDIA_USD=
PLUS_MONTHLY_MEDIA_USD=
PRO_MONTHLY_MEDIA_USD=
ULTRA_MONTHLY_MEDIA_USD=
# Общий бюджет сайта на бесплатные запросы в сутки, в долларах (например 5). Когда он исчерпан,
# бесплатные запросы ждут полуночи по UTC; Pro, кредиты и свои ключи продолжают работать. Пусто — без ограничения.
AI_DAILY_BUDGET_USD=

# AI-кредиты: тратятся, когда дневной лимит закончился. Один кредит покрывает столько долларов
# расходов на ИИ (по умолчанию 0.002 — примерно одно сообщение быстрой модели).
CREDIT_VALUE_USD=
# Пакеты на продажу: «кредиты:цена в рублях:цена в долларах» через запятую. Цену для способа оплаты,
# которого у вас нет, можно не указывать: «500:199» — только за рубли.
# По умолчанию 300:149:1.99,1000:399:4.99,5000:1690:19.99
CREDIT_PACKS=
# Модель распознавания речи через OpenRouter (по умолчанию openai/gpt-4o-mini-transcribe, запасная — openai/whisper-1).
# STT_MODEL=

# ---------- Оплата (необязательно; без неё Pro и кредиты можно выдавать промокодами) ----------

# ЮKassa — карты РФ, СБП, SberPay: https://yookassa.ru
# Личный кабинет → Интеграция → Ключи API. Автоплатежи включает менеджер ЮKassa.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Цена Pro в рублях за месяц (по умолчанию 990).
PRO_PRICE_RUB=
# true, если чеки (54-ФЗ) отправляются через «Чеки от ЮKassa».
YOOKASSA_RECEIPTS=
# Ставка НДС в чеке: 1 — без НДС, 11 — 22%, 12 — 22/122 (по умолчанию 1).
YOOKASSA_VAT_CODE=

# Stripe — международные карты: https://dashboard.stripe.com
# Для продажи кредитов и тарифов Plus, Pro, Ultra достаточно ключа и секрета вебхука.
STRIPE_SECRET_KEY=
# Цены тарифов в долларах за месяц (по умолчанию Plus 4.99, Pro 9.99, Ultra 24.99; 0 — тариф не продаётся).
PLUS_PRICE_USD=
PRO_PRICE_USD=
ULTRA_PRICE_USD=
# Или ID цен, созданных в Stripe → Product catalog (price_...): тогда берутся они.
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ULTRA=
# Секрет вебхука (whsec_...) для адреса <сайт>/api/billing/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# Paddle — продаёт как Merchant of Record (сам считает и платит налоги): https://vendors.paddle.com
# API-ключ (My account → Settings → Authentication; pdl_live_... или для песочницы pdl_sdbx_...).
PADDLE_API_KEY=
# Client-side token для окна оплаты (там же, вкладка Client-side tokens; live_... или test_...) — он публичный по устройству Paddle.
PADDLE_CLIENT_TOKEN=
# Секрет уведомлений (Developer tools → Notifications → адрес <сайт>/api/billing/paddle/webhook).
PADDLE_WEBHOOK_SECRET=
# ID цен тарифов из каталога Paddle (pri_...); тариф без цены через Paddle не продаётся.
PADDLE_PRICE_PLUS=
PADDLE_PRICE_PRO=
PADDLE_PRICE_ULTRA=
# sandbox — песочница (по умолчанию определяется по ключу pdl_sdbx_).
PADDLE_ENV=
# Необязательно: товар для пакетов кредитов (pro_...) и налоговая категория (по умолчанию standard).
PADDLE_CREDITS_PRODUCT=
PADDLE_TAX_CATEGORY=

# PayPal — оплата месяца тарифа и кредитов разово, без автопродления: https://developer.paypal.com
# REST-приложение (Apps & Credentials): Client ID и Secret. Вебхук (необязательно, для надёжности):
# <сайт>/api/billing/paypal/webhook с событиями CHECKOUT.ORDER.APPROVED и PAYMENT.CAPTURE.COMPLETED.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox — тестовые ключи; по умолчанию live.
PAYPAL_MODE=

# TON (криптовалюта) — переводы на ваш кошелёк с кодом в комментарии, без регистрации в платёжной системе.
# Адрес кошелька (UQ... или EQ...), куда приходят оплаты.
TON_WALLET=
# Необязательно: ключ TON Center (https://toncenter.com, бот @tonapibot) — больше запросов в секунду.
TONCENTER_API_KEY=

# Секрет для ежедневных задач: продление подписок, «Задачи» по расписанию, уборка
# временных чатов (Vercel Cron передаёт его сам; «будильнику» — в заголовке
# Authorization: Bearer <секрет>, см. README).
CRON_SECRET=

# ---------- Карты (необязательно) ----------

# Свои сервера OpenStreetMap для большой нагрузки (по умолчанию — бесплатные публичные;
# в OVERPASS_URL можно перечислить несколько через запятую — они пробуются по очереди).
NOMINATIM_URL=
OVERPASS_URL=
# То же для браузера посетителя (он ищет места сам): адреса через запятую.
NEXT_PUBLIC_OVERPASS_URL=
# Своя подложка карты, шаблон адреса тайлов с {z}/{x}/{y} (по умолчанию — CARTO).
NEXT_PUBLIC_MAP_TILES=
# Или подложка Mapbox (светлая и тёмная): публичный токен pk.… из кабинета Mapbox, ограниченный вашим доменом.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ---------- Закрытый доступ (необязательно) ----------

# Если задать, весь сайт сначала спросит этот пароль (логин — любой).
# Удобно для закрытого бета-теста.
APP_PASSWORD=
