# Скопируйте этот файл в .env.local и заполните нужные значения.
# Для запуска на своём компьютере достаточно ОДНОГО ключа провайдера:
# база данных и хранилище файлов создадутся сами в папке .data/.
# Все значения читаются только на сервере и никогда не попадают в браузер.

# ---------- Модели: чат ----------

# Claude (Opus, Sonnet, Haiku, Fable): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# GPT-модели + генерация изображений GPT Image: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Gemini + изображения (Imagen, Nano Banana) + видео (Veo): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Сотни моделей через один ключ (Llama, Mistral, Qwen, DeepSeek…): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Grok: https://console.x.ai
XAI_API_KEY=

# Свои локальные модели через Ollama (https://ollama.com): бесплатно, без ключей.
# После установки: `ollama pull llama3.2`, затем раскомментируйте строку ниже.
# OLLAMA_BASE_URL=http://localhost:11434

# ---------- Модели: изображения и видео ----------

# FLUX, Ideogram, Recraft, Kling, Veo, Seedance и тысячи других моделей:
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# ---------- База данных и файлы ----------

# PostgreSQL (на Vercel: Storage → Neon, переменная появится сама).
# Пусто = встроенная база в .data/ (только для своего компьютера).
DATABASE_URL=

# Хранилище файлов Vercel Blob (Storage → Blob, тип доступа Private).
# Пусто = файлы в папке .data/files/.
BLOB_READ_WRITE_TOKEN=

# ---------- Аккаунты ----------

# Секрет для подписи сессий: 32+ случайных символа (`openssl rand -base64 32`).
# Обязателен на Vercel. Локально, если пусто, создаётся сам в .data/.
BETTER_AUTH_SECRET=

# Адрес сайта, например https://nexus-ai.vercel.app (на Vercel определяется сам).
BETTER_AUTH_URL=

# Вход через Google (необязательно). Redirect URI: <адрес сайта>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Вход через VK ID (необязательно). Redirect URI: <адрес сайта>/api/auth/callback/vk
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# Почты администраторов через запятую: без лимитов и видят статус провайдеров.
ADMIN_EMAILS=

# ---------- Лимиты бесплатного тарифа (в сутки на пользователя) ----------
# Число или `unlimited`. По умолчанию: 50 сообщений, 10 изображений, 2 видео.
FREE_DAILY_CHAT=
FREE_DAILY_IMAGE=
FREE_DAILY_VIDEO=

# ---------- Закрытый доступ (необязательно) ----------

# Если задать, весь сайт сначала спросит этот пароль (логин — любой).
# Удобно для закрытого бета-теста.
APP_PASSWORD=
